# ============================================================
# WeChatBot 全栈 Docker Compose 环境变量模板
# 复制为 .env 后填写，docker compose up -d 即用
# ============================================================

# 数据库
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wechatbot
# MYSQL_PORT=127.0.0.1:3306

# 阿里云百炼 DashScope（文字/视觉模型 + Embedding，MCP Server 与 App 共用）
DASHSCOPE_API_KEY=

# 火山引擎 Ark（虚拟试衣 doubao-seedream-4.0，MCP Server 使用）
ARK_API_KEY=

# 博查搜索（MCP Server 可选；不填自动走 DuckDuckGo 免费方案）
# BOCHA_API_KEY=

# 会话与安全（自行生成强密钥）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
# 生成 32 字节 base64：PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
APP_ADMIN_SESSION_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=

# 功能开关
# ILINK_ENABLED=true          # 接真实微信时开启
# FASHION_SEMANTIC_ENABLED=true  # 开启 Qdrant 衣橱语义检索
# FASHION_REFERENCE_ENABLED=true  # 开启公共参考库
# SPRING_AI_MODEL=qwen3.7-plus

# 端口映射（默认仅本机可访问）
# APP_PORT=8080
# MCP_SERVER_PORT=127.0.0.1:8090
# QDRANT_HTTP_PORT=127.0.0.1:6333
# QDRANT_GRPC_PORT=127.0.0.1:6334