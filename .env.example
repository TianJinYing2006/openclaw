# ============================================================
# WeChatBot 服务端环境变量模板
# 用法：cp .env.example .env   然后填真实值（.env 切勿提交进 git）
# ============================================================

# ---------- 必填：大模型（DashScope / 通义千问）----------
DASHSCOPE_API_KEY=sk-your-dashscope-key
SPRING_AI_MODEL=qwen3.7-plus

# ---------- 必填：Langfuse（用量页 + 链路可观测）----------
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# OTLP 导出头：Basic 为 base64(publicKey:secretKey)，用下面命令生成后粘贴
#   printf '%s' "pk-lf-xxxx:sk-lf-xxxx" | base64
LANGFUSE_OTLP_HEADERS=Authorization=Basic xxxxxxxxxxxxxxxx,x-langfuse-ingestion-version=4
LANGFUSE_OTLP_ENABLED=true
LANGFUSE_OTLP_ENDPOINT=https://jp.cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_PROTOCOL=http/protobuf

# ---------- 数据库 / Redis（容器内服务，可保持默认）----------
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=wechatbot
MYSQL_PORT=127.0.0.1:3306
QDRANT_HTTP_PORT=127.0.0.1:6333
QDRANT_GRPC_PORT=127.0.0.1:6334
MCP_SERVER_PORT=127.0.0.1:8090
# MCP Server 鉴权令牌（app 与 mcp-server 共用）；留空则不带鉴权头，仅限本机/内网隔离部署
MCP_AUTH_TOKEN=

# ---------- 管理后台（务必改强密码；下面示例值是占位符，应用会拒绝启动直到你改成真实强密码）----------
APP_ADMIN_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-strong
APP_ADMIN_PORT=8081
APP_PORT=8080

# ---------- 穿搭多 Agent 图运行时（默认开启；关闭后 fashion_consultant 仅返回安全兜底）----------
FASHION_GRAPH_ENABLED=true
# 可选：HITL 付费操作前确认、执行预算护栏（默认关闭）
FASHION_GRAPH_HITL_ENABLED=false
FASHION_GRAPH_BUDGET_ENABLED=false

# ---------- iLink 微信（要让 bot 真在服务器回消息则设 true，需托管登录一次）----------
ILINK_ENABLED=false

# ---------- MCP Server 外部密钥（按需）----------
ARK_API_KEY=
BOCHA_API_KEY=

# ---------- 可选：RAGFlow（完整穿搭检索才需要；用量页不依赖）----------
# RAGFLOW_HOST=http://your-ragflow-host:9380
