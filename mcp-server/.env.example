# ================================================================
# MCP Server 环境变量配置
# 复制此文件为 .env，填入你的 Key
# ================================================================

# 百炼 API Key（用于衣橱识别和虚拟试衣）
# 注册：https://bailian.console.aliyun.com/
# 与 WeChatBot 项目共用同一个 Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 百炼 OpenAI 兼容接口地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型（衣橱识别用）
VISION_MODEL=qwen-vl-max

# 博查搜索 API Key（可选）
# 不填则自动使用 DuckDuckGo 免费搜索
# 注册：https://www.bochaai.com/
BOCHA_API_KEY=

# MCP Server 监听地址与端口
# 默认仅绑定本机（127.0.0.1），防止局域网其它机器直接调用工具；
# 需要从其它机器访问时改为 0.0.0.0（并自行加访问控制）
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8090

# ================================================================
# 虚拟试衣配置（火山引擎 doubao-seedream-4.0，唯一 Provider）
# ================================================================
# 火山方舟 API Key（必填）
# 注册并开通模型：https://console.volcengine.com/ark
# 获取 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=

# 模型 ID（默认 doubao-seedream-4-0-250828，可改用你自己的推理接入点 ID）
ARK_MODEL=doubao-seedream-4-0-250828

# 火山方舟接口地址（一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 输出分辨率：1K / 2K / 4K
ARK_SIZE=2K

# 单次请求超时（秒）与瞬时错误重试次数
ARK_TIMEOUT=120
ARK_RETRIES=2
